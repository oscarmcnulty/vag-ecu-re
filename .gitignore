# Large binary assets (track via symlink / external storage, not git)
*.bin
*.ols
*.pdf
*.frf
*.odx-f
ecus/*/firmware/*
# --- per-variant ECU subfolders (e.g. ecus/esp8/<partno>/) -----------------
# Same hard rule one level deeper: firmware and Ghidra projects never enter git.
ecus/*/*/firmware/*
ecus/*/*/ghidra_proj/
ecus/*/*/frf/
# Flash containers are firmware. .frf was already covered; .odx / .odx-f / .sgo are the
# decrypted/unpacked forms of the same copyrighted image and must be ignored too.
*.odx
*.sgo
*.sgm
# comma/openpilot drive logs (large, private; not repo content)
*.zst
*--rlog*
# Ghidra projects & generated artifacts (fully regenerable via reproduce.sh)
ecus/*/ghidra_proj/
*.gpr
*.rep/
*.lock
*.lock~
# JVM crash/replay dumps -- Ghidra headless drops these in the CWD and they carry
# local paths + full command lines. Never repo content.
hs_err_pid*.log
replay_pid*.log
*.hprof
# editor/agent local state (also covered by some users' global ignore -- pin it here
# so it does not depend on machine config)
.claude/settings.local.json
.claude/*.lock
annotations/
__pycache__/
*.pyc
# Decompiled C is a DERIVED WORK of the (copyrighted) firmware -- never commit it.
# Regenerate locally with ecus/<ecu>/reproduce.sh from the version-controlled metadata
# (analysis/function_entries.txt + analysis/symbols_merged.csv + core/ghidra/*.java).
decompiles/
ecus/*/analysis/decompiles*/
# per-function decompile outcome manifest (regenerable via reproduce.sh step 6 / DecompileAll.java)
ecus/*/analysis/decompiles*.manifest.csv
# annotated disasm for decompiler-degraded fns (regenerable via reproduce.sh step 6b / DumpDisasmFns.java)
ecus/*/analysis/disasm_r/
ecus/*/analysis/degraded_fns.txt
ecus/*/analysis/recovered_returns.csv

# machine-specific env (use .env.sh.example as template)
.env.sh
# generated annotation sidecars (regenerable; keep curated symbols.csv only)
ecus/*/analysis/annotations*/
# iterative closed-loop outputs (regenerable via core/pipeline/iterate.py)
ecus/*/analysis/decompiles_p*/
ecus/*/analysis/callgraph_*.csv
# a1-relative cal-access table (regenerable via reproduce.sh step 6 / ResolveCalReads.java)
ecus/*/analysis/cal_reads.csv
# a9-object-table cal accesses (regenerable via ResolveCalReadsA9.java). MUST stay ignored: its
# `value` column carries firmware bytes, so it is derived work, unlike the address-only metadata.
ecus/*/analysis/cal_reads_a9.csv
ecus/*/analysis/dispatch_resolved.csv
# reproduce.sh build outputs (derived from committed sources -- regenerated every run):
#   a2l_symbols.csv <- a2l_to_symbols.py(simos85.a2l) at step 4b
#   map_calls.csv   <- TraceMapCalls.java at step 8
ecus/*/maps/a2l_symbols.csv
ecus/*/maps/map_calls.csv
# ad-hoc ScanCalIndexed.java diagnostic output (regenerable)
ecus/*/analysis/scan_*.csv
ecus/*/analysis/symbols_iter.csv
ecus/*/analysis/iter_metrics.json
ecus/*/analysis/iter_logs/
# Derived Funktionsrahmen index. The FR is a proprietary Continental/Bosch document;
# any index/excerpt derived from it is treated like the decompiled C -- regenerable from
# the PDF via core/pdf/fr_index.py, never committed.
ecus/*/analysis/fr/
ecus/*/analysis/*.log
ecus/*/maps/*.log
# per-step headless logs from ecus/<ecu>/reproduce.sh (regenerable)
ecus/*/analysis/_logs/
ecus/*/analysis/_rerun_logs/
# derived diagnostics from the coverage / orphan-claim steps (regenerable)
ecus/*/analysis/unaccounted_runs.csv
ecus/*/analysis/orphan_entries*.txt
ecus/*/analysis/gapwalk_entries.txt
# indirect-branch audit (regenerable via reproduce.sh step 11b / AuditIndirectBranches.java)
ecus/*/analysis/indirect_branches.csv
# pointer-table audit (regenerable via reproduce.sh step 4d / RecoverPointerTargets.java).
# Report-only by design: its candidates are mostly data that merely looks like code pointers,
# so vetted entries belong in function_entries.txt, never this file.
ecus/*/analysis/pointer_target_audit*.txt
# bracketed-code recovery entries (regenerable via reproduce.sh step 4c / RecoverBracketedCode.java)
ecus/*/analysis/bracketed_entries*.txt

# nohup driver output (regenerable)
ecus/*/analysis/reproduce.out

# --- AL551 (SH-2A TCU): derived firmware VALUES -> gitignored, regenerable from committed scripts.
# Map/axis CSVs carry firmware map contents (breakpoints, grids) -> derived work. Regenerate
# with ecus/al551/analysis/extract_maps.py.
ecus/al551/analysis/torque_maps.csv
ecus/al551/analysis/shift_curves.csv
ecus/al551/analysis/shift_blocks.csv
ecus/al551/analysis/cal_axes.csv
ecus/al551/analysis/cal_ptr_tables.csv
# RAM base-pointer image, resolved by emulation (like dispatch_resolved.csv). Regenerate with
# ecus/al551/analysis/gen_ram_bases.sh (InitEmu.java).
ecus/al551/analysis/ram_bases.csv
# reproduce.sh byproducts (regenerated every run)
ecus/al551/analysis/indirect_branches.csv
ecus/al551/analysis/orphan_entries_*.txt
ecus/al551/analysis/bracketed_entries_*.txt
ecus/al551/analysis/ptr_created_*.txt
ecus/al551/analysis/pointer_target_audit_*.txt
ecus/al551/analysis/basereg.log
ecus/al551/analysis/_run.log

# Repo-root firmware & decoded-plaintext (DERIVED from copyrighted firmware -- never commit).
# .bin is already ignored; ignore the containing dirs + raw dumps explicitly (defense in depth).
tcu_8R_plaintext/
tcu_blocks/
tcu_blocks_4H/
benchdump/
*.zip
*.exe
# AL551 flash prep outputs (firmware-derived block payloads)
ecus/al551/flash/*.bin
ecus/al551/flash/block_crc32.txt
