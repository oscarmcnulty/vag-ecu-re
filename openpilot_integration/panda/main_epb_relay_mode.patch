+static bool epb_bridge_engaged = false;
+#endif
+
 // this is the only way to leave silent mode
 void set_safety_mode(uint16_t mode, uint16_t param) {
   uint16_t mode_copy = mode;
@@ -105,6 +111,22 @@ void set_safety_mode(uint16_t mode, uint16_t param) {
       }
       can_silent = ALL_CAN_LIVE;
       break;
+    case SAFETY_VW_EPB_RELAY:
+      // Secondary inline EPB-relay panda. Start DISENGAGED (stock passthrough): intercept relay
+      // closed so the EPB wire stays a direct EPB<->ABS link, and all buses listen-only. The 8 Hz
+      // tick handler (epb_relay_apply_engagement) opens the relay and enables bus 0<->2 forwarding
+      // only while ACC_05 is live on bus 1. No USB host is required to reach this mode.
+      set_intercept_relay(false, false);
+      heartbeat_counter = 0U;
+      heartbeat_lost = false;
