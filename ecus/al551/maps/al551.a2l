ASAP2_VERSION 1 71
/begin PROJECT AL551 "Audi AL551 / ZF 8HP TCU (Renesas SH72519, big-endian)"
  /begin HEADER "AL551 tuning A2L - RE in ecus/al551 (CAN + control loops + cal maps)"
    VERSION "8R0927158AM_1003"
  /end HEADER
  /begin MODULE AL551 "ZF 8HP45/8HP55 TCU; Q5/SQ5 3.0T; SW1003"
    /begin MOD_COMMON "big-endian SH-2A, byte-aligned"
      BYTE_ORDER MSB_FIRST
      ALIGNMENT_BYTE 1  ALIGNMENT_WORD 2  ALIGNMENT_LONG 4
    /end MOD_COMMON
    /begin MOD_PAR "flash/RAM layout (bri3d VW_Flash#123 + SH72519 map)"
      /* CAL CRC32 over 0x190000..0x1FFD5F stored at 0x180244 */
      /begin MEMORY_SEGMENT RESERVED_boot "RESERVED" RESERVED FLASH INTERN 0x0 0x40000 -1 -1 -1 -1 -1
      /end MEMORY_SEGMENT
      /begin MEMORY_SEGMENT CODE_asw "CODE" CODE FLASH INTERN 0x40080 0x13FAF0 -1 -1 -1 -1 -1
      /end MEMORY_SEGMENT
      /begin MEMORY_SEGMENT CODE_boot2 "CODE" CODE FLASH INTERN 0x180280 0xFD80 -1 -1 -1 -1 -1
      /end MEMORY_SEGMENT
      /begin MEMORY_SEGMENT DATA_cal "DATA" DATA FLASH INTERN 0x190000 0x6FD60 -1 -1 -1 -1 -1
      /end MEMORY_SEGMENT
      /begin MEMORY_SEGMENT RAM_signals "DATA" DATA RAM INTERN 0xFFF80000 0x40000 -1 -1 -1 -1 -1
      /end MEMORY_SEGMENT
    /end MOD_PAR
    /begin COMPU_METHOD CM_IDENT "identity" IDENTICAL "%.0f" "" /end COMPU_METHOD
    /begin COMPU_METHOD CM_RAW "raw byte" IDENTICAL "%.0f" "-" /end COMPU_METHOD
    /begin COMPU_METHOD CM_RPM "engine/turbine speed" IDENTICAL "%.0f" "rpm" /end COMPU_METHOD
    /begin COMPU_METHOD CM_KMH "vehicle speed" LINEAR "%.2f" "km/h" COEFFS_LINEAR 0.01 0 /end COMPU_METHOD
    /begin COMPU_METHOD CM_NM "torque" IDENTICAL "%.0f" "Nm" /end COMPU_METHOD
    /begin COMPU_METHOD CM_PCT "throttle/load" IDENTICAL "%.1f" "%" /end COMPU_METHOD
    /begin RECORD_LAYOUT RL_U8 FNC_VALUES 1 UBYTE ROW_DIR DIRECT /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_U16 FNC_VALUES 1 UWORD ROW_DIR DIRECT /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_U32 FNC_VALUES 1 ULONG ROW_DIR DIRECT /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_S16 FNC_VALUES 1 SWORD ROW_DIR DIRECT /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_AXIS_U16 AXIS_PTS_X 1 UWORD INDEX_INCR DIRECT /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_CURVE_U16 FNC_VALUES 1 UWORD ROW_DIR DIRECT /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_MAP_U16 FNC_VALUES 1 UWORD COLUMN_DIR DIRECT /end RECORD_LAYOUT
    /* shared shift-curve input axis [1340 2015 3000 3770 4885 6300 7500] rpm */
    /begin AXIS_PTS AX_shift_rpm "shift input rpm axis (7pt)" 0x1d3330 NO_INPUT_QUANTITY RL_AXIS_U16 0 CM_RPM 7 0 8000 /end AXIS_PTS
    /* torque-limit engine-input-torque column axis (8pt, 0..600 Nm) */
    /begin AXIS_PTS AX_tq_col "engine input torque axis (Nm)" 0x1b0c10 NO_INPUT_QUANTITY RL_AXIS_U16 0 CM_NM 8 0 600 /end AXIS_PTS
    /begin AXIS_PTS AX_tq_row "torque-map row axis (10pt)" 0x1b0bf8 NO_INPUT_QUANTITY RL_AXIS_U16 0 CM_IDENT 10 0 4096 /end AXIS_PTS
    /* ---- CAN RX 8-byte frame buffers (on-chip RAM) ---- */
    /begin MEASUREMENT CANRX_buf_0x4c "CAN RX frame buffer msg_index 0x4c" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91ae8 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x4d "CAN RX frame buffer msg_index 0x4d" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91af0 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x4e "CAN RX frame buffer msg_index 0x4e" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b08 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x4f "CAN RX frame buffer msg_index 0x4f" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b10 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x50 "CAN RX frame buffer msg_index 0x50" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b18 MATRIX_DIM 8 /end MEASUREMENT
