+    if (current_safety_mode == SAFETY_VW_EPB_RELAY) {
+      epb_relay_apply_engagement(epb_relay_should_engage());
+    }
+#endif
+
     // decimated to 1Hz
     if (loop_counter == 0U) {
       can_live = pending_can_live;
@@ -233,7 +303,9 @@ static void tick_handler(void) {
         heartbeat_engaged_mismatches = 0U;
       }
 
-      if (!heartbeat_disabled) {
+      // SAFETY_VW_EPB_RELAY is autonomous (no USB host) and self-gates on ACC_05 liveness,
+      // so it is exempt from the USB-heartbeat cutout / power-save that would force SILENT.
+      if (!heartbeat_disabled && (current_safety_mode != SAFETY_VW_EPB_RELAY)) {
         // if the heartbeat has been gone for a while, go to SILENT safety mode and enter power save
         if (heartbeat_counter >= (check_started() ? HEARTBEAT_IGNITION_CNT_ON : HEARTBEAT_IGNITION_CNT_OFF)) {
           print("device hasn't sent a heartbeat for 0x");
@@ -336,8 +408,15 @@ int main(void) {
     fan_init();
   }
 
+#ifndef STM32H7
+  // Boot directly into the autonomous EPB-relay bridge (starts DISENGAGED = stock passthrough;
+  // engages only when ACC_05 is live on bus 1). This is what makes the secondary panda work with
+  // no USB host attached. To use this panda for anything else, reflash or set mode over USB.
+  set_safety_mode(SAFETY_VW_EPB_RELAY, 0U);
+#else
