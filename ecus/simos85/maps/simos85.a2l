ASAP2_VERSION 1 71
/begin PROJECT SIMOS85 "VAG Simos8.5 recovered calibration"
  /begin MODULE SIMOS85 ""
    /begin MOD_COMMON ""
      BYTE_ORDER MSB_LAST
      ALIGNMENT_BYTE 1
      ALIGNMENT_WORD 2
    /end MOD_COMMON
    /begin COMPU_METHOD CM_IDENTITY "1:1" RAT_FUNC "%.3f" "-"
      COEFFS 0 1 0 0 0 1
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L0 "phys=0.390625*x+0" LINEAR "%.5f" "-"
      COEFFS_LINEAR 0.390625 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L1 "phys=1*x+0" LINEAR "%.5f" "km/h"
      COEFFS_LINEAR 1 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L2 "phys=0.01*x+0" LINEAR "%.5f" "km/h"
      COEFFS_LINEAR 0.01 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L3 "phys=0.0078125*x+0" LINEAR "%.5f" "km/h"
      COEFFS_LINEAR 0.0078125 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L4 "phys=0.001*x+0" LINEAR "%.5f" "m/s^2"
      COEFFS_LINEAR 0.001 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L5 "phys=0.005*x+0" LINEAR "%.5f" "m/s^2"
      COEFFS_LINEAR 0.005 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L6 "phys=2*x+0" LINEAR "%.5f" "-"
      COEFFS_LINEAR 2 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L7 "phys=32*x+0" LINEAR "%.5f" "RPM"
      COEFFS_LINEAR 32 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L8 "phys=1*x-40" LINEAR "%.5f" "C"
      COEFFS_LINEAR 1 -40
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L9 "phys=0.75*x-48" LINEAR "%.5f" "C"
      COEFFS_LINEAR 0.75 -48
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L10 "phys=0.004*x+0" LINEAR "%.5f" "ms"
      COEFFS_LINEAR 0.004 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L11 "phys=5.44706*x+0" LINEAR "%.5f" "mg/stk"
      COEFFS_LINEAR 5.44706 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L12 "phys=0.03125*x-1024" LINEAR "%.5f" "Nm"
      COEFFS_LINEAR 0.03125 -1024
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L13 "phys=1*x+0" LINEAR "%.5f" "Gear"
      COEFFS_LINEAR 1 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L14 "phys=1*x+0" LINEAR "%.5f" "RPM"
      COEFFS_LINEAR 1 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L15 "phys=0.03125*x+0" LINEAR "%.5f" "Nm"
      COEFFS_LINEAR 0.03125 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L16 "phys=0.0211948*x+0" LINEAR "%.5f" "Engine Air Charge"
      COEFFS_LINEAR 0.0211948 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L17 "phys=3.05176e-05*x+0" LINEAR "%.5f" "-"
      COEFFS_LINEAR 3.05176e-05 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L18 "phys=0.0423896*x+0" LINEAR "%.5f" "mg/stk"
      COEFFS_LINEAR 0.0423896 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L19 "phys=0.03125*x-1024" LINEAR "%.5f" "-"
      COEFFS_LINEAR 0.03125 -1024
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L20 "phys=0.03125*x+0" LINEAR "%.5f" "-"
      COEFFS_LINEAR 0.03125 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L21 "phys=0.000265336*x+0" LINEAR "%.5f" "MPa"
      COEFFS_LINEAR 0.000265336 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L22 "phys=0.0211948*x+0" LINEAR "%.5f" "mg/stk"
      COEFFS_LINEAR 0.0211948 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L23 "phys=0.000265*x+0" LINEAR "%.5f" "MPa"
      COEFFS_LINEAR 0.000265 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L24 "phys=0.375*x+0" LINEAR "%.5f" "Deg CR"
      COEFFS_LINEAR 0.375 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L25 "phys=0.00085*x-27.8528" LINEAR "%.5f" "m/s^2"
      COEFFS_LINEAR 0.00085 -27.8528
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L26 "phys=1.5259e-05*x+0" LINEAR "%.5f" "norm"
      COEFFS_LINEAR 1.5259e-05 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_L27 "phys=0.000976563*x+0 (unity=1024)" LINEAR "%.5f" "-"
      COEFFS_LINEAR 0.000976563 0
    /end COMPU_METHOD
    /begin RECORD_LAYOUT RL_V_UBYTE
      FNC_VALUES 1 UBYTE ROW_DIR DIRECT
    /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_V_UWORD
      FNC_VALUES 1 UWORD ROW_DIR DIRECT
    /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_V_SWORD
      FNC_VALUES 1 SWORD ROW_DIR DIRECT
    /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_AX_UBYTE
      AXIS_PTS_X 1 UBYTE INDEX_INCR DIRECT
    /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_AX_UWORD
      AXIS_PTS_X 1 UWORD INDEX_INCR DIRECT
    /end RECORD_LAYOUT
    /begin AXIS_PTS AP_80042285 "" 0x80042285 NO_INPUT_QUANTITY RL_AX_UBYTE 0 CM_L13 7 0 255
