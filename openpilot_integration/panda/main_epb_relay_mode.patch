     default:
       set_intercept_relay(true, false);
       heartbeat_counter = 0U;
@@ -122,9 +144,50 @@ bool is_car_safety_mode(uint16_t mode) {
   return (mode != SAFETY_SILENT) &&
          (mode != SAFETY_NOOUTPUT) &&
          (mode != SAFETY_ALLOUTPUT) &&
+         (mode != SAFETY_VW_EPB_RELAY) &&
          (mode != SAFETY_ELM327);
 }
 
+#ifndef STM32H7
+// ACC_05 liveness poll (8 Hz). Returns true while counter-valid ACC_05 keeps arriving on bus 1
+// (engage the bridge), false once it has been stale for EPB_RELAY_STALE_TICKS ticks (disengage).
+// Starts stale => the panda boots disengaged and self-heals. Reads epb_relay.acc05_good, the
+// monotonic count of checksum+counter-valid ACC_05 frames maintained by epb_relay_rx().
+static bool epb_relay_should_engage(void) {
+  static uint32_t last_good = 0U;
+  static uint8_t  stale     = EPB_RELAY_STALE_TICKS;   // start stale => boot disengaged
+  uint32_t now = epb_relay.acc05_good;
+  if (now != last_good) {
+    last_good = now;
+    stale = 0U;
+  } else if (stale < EPB_RELAY_STALE_TICKS) {
+    stale++;
+  } else {
+    // already fully stale
+  }
+  return (stale < EPB_RELAY_STALE_TICKS);
+}
+
+// EPB-relay bridge: engage (intercept relay open, bus 0<->2 forwarding, bus 1 listen-only) while
+// ACC_05 is live, otherwise disengage to stock passthrough (relay closed = direct EPB<->ABS wire,
+// all buses listen-only). Only touches hardware on an actual state change, so can_init_all() runs
+// on transitions, not every tick. Called at 8 Hz from the tick handler.
+static void epb_relay_apply_engagement(bool engage) {
+  if (engage == epb_bridge_engaged) { return; }
+  epb_bridge_engaged = engage;
+  if (engage) {
+    set_intercept_relay(true, false);
+    can_silent = (int)(1U << CAN_NUM_FROM_BUS_NUM(1U));   // bus 1 (ACC_05 tap) listen-only; buses 0/2 live
+    current_safety_config.disable_forwarding = false;
+  } else {
+    set_intercept_relay(false, false);
+    can_silent = ALL_CAN_SILENT;
+    current_safety_config.disable_forwarding = true;
+  }
+  can_init_all();
+}
+#endif
+
 // ***************************** main code *****************************
 
 // cppcheck-suppress unusedFunction ; used in headers not included in cppcheck
