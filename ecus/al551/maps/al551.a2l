    /begin MEASUREMENT CANRX_buf_0x56 "CAN RX frame buffer msg_index 0x56" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b50 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x57 "CAN RX frame buffer msg_index 0x57" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b58 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x58 "CAN RX frame buffer msg_index 0x58" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b60 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x59 "CAN RX frame buffer msg_index 0x59" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b68 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x5a "CAN RX frame buffer msg_index 0x5a" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b70 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x5b "CAN RX frame buffer msg_index 0x5b" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b78 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x5c "CAN RX frame buffer msg_index 0x5c" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b80 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x5d "CAN RX frame buffer msg_index 0x5d" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b88 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x5e "CAN RX frame buffer msg_index 0x5e" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b90 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x5f "CAN RX frame buffer msg_index 0x5f" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b98 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x60 "CAN RX frame buffer msg_index 0x60" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91ba0 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x61 "CAN RX frame buffer msg_index 0x61" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91ba8 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x62 "CAN RX frame buffer msg_index 0x62" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91bb0 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANRX_buf_0x01 "CAN RX frame buffer msg_index 0x01" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91bb8 MATRIX_DIM 8 /end MEASUREMENT
    /* ---- CAN TX frame buffers ---- */
    /begin MEASUREMENT CANTX_Getriebe_01 "TX frame 0x082 Getriebe_01" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91c88 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANTX_Getriebe_02 "TX frame 0x083 Getriebe_02" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91cb0 MATRIX_DIM 8 /end MEASUREMENT
    /begin MEASUREMENT CANTX_WBA_01 "TX frame 0x390 WBA_01" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91e60 MATRIX_DIM 4 /end MEASUREMENT
    /* ---- traced control-loop RAM signals ---- */
    /begin MEASUREMENT CHARISMA_FahrPr_latched "Latched drive program, echoed Getriebe_04" UBYTE CM_IDENT 0 0 0 255 ECU_ADDRESS 0xfff95175 /end MEASUREMENT
    /begin MEASUREMENT CHARISMA_FahrPr_input "Drive-program input from Charisma_01(0x385)" UBYTE CM_IDENT 0 0 0 255 ECU_ADDRESS 0xfff95172 /end MEASUREMENT
    /begin MEASUREMENT CHARISMA_FahrPr_rx "Decoded Charisma_01 drive-program byte" UBYTE CM_IDENT 0 0 0 255 ECU_ADDRESS 0xfff89454 /end MEASUREMENT
    /begin MEASUREMENT TorqueLimit_result_0 "Input-torque-limit map result cell 0" UWORD CM_NM 0 0 0 65535 ECU_ADDRESS 0xfff8c814 /end MEASUREMENT
    /begin MEASUREMENT TorqueLimit_result_1 "Input-torque-limit map result cell 1" UWORD CM_NM 0 0 0 65535 ECU_ADDRESS 0xfff8c81c /end MEASUREMENT
    /begin MEASUREMENT TorqueLimit_result_2 "Input-torque-limit map result cell 2" UWORD CM_NM 0 0 0 65535 ECU_ADDRESS 0xfff8c824 /end MEASUREMENT
    /begin MEASUREMENT TCU_OutputShaftSpeed "Output-shaft speed (gear-ratio numerator)" UWORD CM_RPM 0 0 0 65535 ECU_ADDRESS 0xfff95524 /end MEASUREMENT
    /begin MEASUREMENT TCU_InputSpeed_gear "Per-gear input/turbine speed (6 words 0xfff95518..22)" UWORD CM_RPM 0 0 0 65535 ECU_ADDRESS 0xfff95518 /end MEASUREMENT
    /* ==== TUNABLE: input-torque-limit Kennfelder (gear x mode selected) ==== */
    /begin CHARACTERISTIC TQLIM_1b0bf4 "input-torque limit Nm @0x1b0bf4 (10x8 grid)" MAP 0x1b0c20 RL_MAP_U16 0 CM_NM 0 4950
