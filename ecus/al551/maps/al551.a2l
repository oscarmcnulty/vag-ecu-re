    /begin MEASUREMENT CANRX_buf_0x52 "CAN RX frame buffer msg_index 0x52" UBYTE CM_RAW 0 0 0 255 ECU_ADDRESS 0xfff91b30 MATRIX_DIM 8 /end MEASUREMENT
