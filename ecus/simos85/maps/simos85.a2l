    /end AXIS_PTS
    /begin AXIS_PTS AP_80055946 "" 0x80055946 NO_INPUT_QUANTITY RL_AX_UWORD 0 CM_IDENTITY 12 0 65535
    /end AXIS_PTS
    /begin AXIS_PTS AP_80055982 "" 0x80055982 NO_INPUT_QUANTITY RL_AX_UWORD 0 CM_IDENTITY 8 0 65535
    /end AXIS_PTS
    /begin AXIS_PTS AP_80056dd2 "" 0x80056dd2 NO_INPUT_QUANTITY RL_AX_UWORD 0 CM_L16 12 0 65535
    /end AXIS_PTS
    /begin AXIS_PTS AP_80056e31 "" 0x80056e31 NO_INPUT_QUANTITY RL_AX_UBYTE 0 CM_L7 16 0 255
    /end AXIS_PTS
    /begin AXIS_PTS AP_80059cf9 "" 0x80059cf9 NO_INPUT_QUANTITY RL_AX_UBYTE 0 CM_L7 12 0 255
    /end AXIS_PTS
    /begin AXIS_PTS AP_8005a4c6 "" 0x8005a4c6 NO_INPUT_QUANTITY RL_AX_UWORD 0 CM_L2 6 0 65535
    /end AXIS_PTS
    /begin AXIS_PTS AP_8005a4f6 "" 0x8005a4f6 NO_INPUT_QUANTITY RL_AX_UWORD 0 CM_L26 6 0 65535
    /end AXIS_PTS
    /begin AXIS_PTS AP_8005a782 "" 0x8005a782 NO_INPUT_QUANTITY RL_AX_UWORD 0 CM_L22 10 0 65535
    /end AXIS_PTS
    /begin AXIS_PTS AP_8005a811 "" 0x8005a811 NO_INPUT_QUANTITY RL_AX_UBYTE 0 CM_L7 8 0 255
    /end AXIS_PTS
    /begin AXIS_PTS AP_8006fa62 "" 0x8006fa62 NO_INPUT_QUANTITY RL_AX_UWORD 0 CM_L18 12 0 65535
    /end AXIS_PTS
    /begin AXIS_PTS AP_8006fae5 "" 0x8006fae5 NO_INPUT_QUANTITY RL_AX_UBYTE 0 CM_L7 16 0 255
    /end AXIS_PTS
    /begin AXIS_PTS AP_80073bd5 "" 0x80073bd5 NO_INPUT_QUANTITY RL_AX_UBYTE 0 CM_L11 10 0 255
    /end AXIS_PTS
    /begin AXIS_PTS AP_80073c35 "" 0x80073c35 NO_INPUT_QUANTITY RL_AX_UBYTE 0 CM_L7 8 0 255
    /end AXIS_PTS
    /begin AXIS_PTS AP_80073e69 "" 0x80073e69 NO_INPUT_QUANTITY RL_AX_UBYTE 0 CM_L7 8 0 255
    /end AXIS_PTS
    /begin CHARACTERISTIC lpfp_max_duty "Maximum Fuel Pump Duty Cycle (lpfp_max_duty)"
      VALUE 0x80043256 RL_V_UBYTE 0 CM_L0 0 99.6094
    /end CHARACTERISTIC
    /begin CHARACTERISTIC C_VS_MIN_CRU_MON_L2_EGAS_monitor_twin "15 km/h; verified (can-trace). EGAS-L2-monitor twin (referenced by egas_l2_monitor_cal_init@800a0c9c) -- NOT the operative cruise-speed floor (that is the u8 pair at file 0x794ef/0x794f2). EGAS-L2 monitor speed gate VS_MON < C_VS_MIN_CRU_MON; loaded by 0x800a0c9c (egas_l2_monitor_cal_init) with ^0xff ASIL verify; FR fig.14.16.5 p2202; stock-clean in Stage1/2."
      VALUE 0x800456c0 RL_V_UBYTE 0 CM_L1 0 255
    /end CHARACTERISTIC
    /begin CHARACTERISTIC C_VS_MIN_CRU_MON_L2_alt_EGAS_monitor_twin "15 km/h; verified (can-trace). EGAS-L2-monitor twin -- NOT the operative cruise-speed floor (u8 pair at file 0x794ef/0x794f2). Co-equal alternate to 0x456c0 (same L2 initializer); the separating literal compare runs in the non-decompiled monitor layer. FR fig.14.16.6 p2203."
      VALUE 0x800456bd RL_V_UBYTE 0 CM_L1 0 255
    /end CHARACTERISTIC
    /begin CHARACTERISTIC C_VS_MIN_CRU_OFF "13 km/h; medium confidence. Likely MON-2 hysteresis/clear threshold (15-2); read indexed by monitor code, not by 0x800a0c9c; FR p2351."
      VALUE 0x800456be RL_V_UBYTE 0 CM_L1 0 255
    /end CHARACTERISTIC
    /begin CHARACTERISTIC C_VS_MIN_CRU_OFF_alt "13 km/h; medium. Second 13-valued hysteresis partner in the L2 monitor cal block 0x456bd..0x456c5."
      VALUE 0x800456c3 RL_V_UBYTE 0 CM_L1 0 255
    /end CHARACTERISTIC
    /begin CHARACTERISTIC C_VS_MIN_CRU_functional "3.0 km/h (raw 384, u16 LE); verified. C_VS_MIN_CRU functional low-speed gate: read at cruise_torque_pi_controller 0x801e9b86:301 as DAT_d000d644 < *(u16)(0xa007a204+0x66) (flash 0x8007a26a; 0xa0 alias). Below this ego speed the cruise torque PI controller takes its near-standstill branch (sets DAT_d000e2c5, feeds integrator reset gate). SCALE = 1/128 km/h (0.0078125) -- forced by the direct compare to DAT_d000d644 (=1/128 km/h); 384/128 = 3.0. Supersedes the earlier 0.01->3.84 reading. Distinct from the 15 km/h L2-monitor floor C_VS_MIN_CRU_MON @0x794ef/0x794f2; co-equal with the 3.0 km/h creep gate @0x80079536. = FR C_VS_MIN_CRU (p.12415, 'minimal vehicle speed for cruise activation'); FR lists res 0.01 (->3.84) but the in-code raw compare to the 1/128 signal makes 1/128 (->3.0) operative. See cruise_control_flow.md."
      VALUE 0x8007a26a RL_V_UWORD 0 CM_L3 0 511.992
    /end CHARACTERISTIC
    /begin CHARACTERISTIC ACC_feature_enable_bitfield_0x7a247 "0x01 stock; verified. ACC sub-feature enable bits read by 0x801e9b86 as *(byte)(0xa007a204+0x43) = flash file 0x7a247. bit4 = desired-accel (ACC_Sollbeschleunigung) shaping path; bits1/3 = active-decel paths; bits5/6/7 = alt setpoint/threshold selects. All off at 0x01 => torque-shaping disabled. Bitfield/hex."
      VALUE 0x8007a247 RL_V_UBYTE 0 CM_IDENTITY 0 255
    /end CHARACTERISTIC
    /begin CHARACTERISTIC c_vs_max_aeb_act "c_vs_max_aeb_act"
      VALUE 0x80043c38 RL_V_UBYTE 0 CM_L1 0 255
    /end CHARACTERISTIC
    /begin CHARACTERISTIC C_VS_MIN_CRU_MON_operative_0x794ef "15 km/h; verified (firmware u8=15). OPERATIVE cruise-speed floor: cal(0x800793a0+0x14f)=flash 0x800794ef, compared da54 <= cal*0x80 (<=15 km/h) at 80102f60:1583 -> debounce d000d79a -> d88b bit5. FR ch.14.16.5. This is the real 15 km/h floor (see acc_flow.md sec.3); distinct from the EGAS-L2 monitor twin at 0x456c0. = FR C_VS_MIN_CRU_MON (p.2196, 'Minimum threshold for vehicle speed control active', = C_VS_MIN_CRU_OFF-2 per p.2351). Move with 0x794f2."
      VALUE 0x800794ef RL_V_UBYTE 0 CM_L1 0 255
    /end CHARACTERISTIC
    /begin CHARACTERISTIC C_VS_MIN_CRU_MON_operative_0x794f2 "15 km/h; verified (firmware u8=15). OPERATIVE cruise-speed floor twin: cal(0x800793a0+0x152)=flash 0x800794f2, compared da54 <= cal*0x80 (DCC-masked) at 80102f60:1645 -> d000d8ab -> d7a7. Move together with 0x794ef to shift the 15 km/h floor."
      VALUE 0x800794f2 RL_V_UBYTE 0 CM_L1 0 255
    /end CHARACTERISTIC
    /begin CHARACTERISTIC ACC_creep_enable_speed_gate_C_VS_MIN_CRU_path "3.0 km/h; verified (firmware u16=384). cal(0x800793a0+0x196)=flash 0x80079536, compared 384 <= da54 at 80102f60:725 -> d88c bit4 = 'moving >= 3 km/h' discriminator (switches ACC status branches standstill<->driving; one AND-term of the dead fatal-deactivation path). Scale 1/128 km/h (X/128). = FR C_VS_MIN_AC_CTL_CRU (p.12502, 'Lower limit of vehicle speed for acceleration control'; candidate). Old 0x180=384 immediate = 3 km/h under confirmed 1/128 scale (NOT 15). See cruise_control_flow.md."
      VALUE 0x80079536 RL_V_UWORD 0 CM_L3 0 511.992
    /end CHARACTERISTIC
    /begin CHARACTERISTIC AC_DCRU_PLAUS_L2_min_3_0 "-3.0 m/s2; verified (firmware s16=-3000). L2 plausibility decel-band minimum at flash 0x80043514, scale 0.001 m/s2. Used by L2 plausibility monitor 800c553c; DTC-isolated (NOT the status/functional decel path). If lowering the functional -3.0 clamp, move this L2 twin too or the L2 monitor faults."
      VALUE 0x80043514 RL_V_SWORD 0 CM_L4 -32.768 32.767
    /end CHARACTERISTIC
    /begin CHARACTERISTIC AC_DCRU_PLAUS_L2_max_2_0 "+2.0 m/s2; verified (firmware s16=2000). L2 plausibility decel-band maximum at flash 0x80043512, scale 0.001 m/s2."
      VALUE 0x80043512 RL_V_SWORD 0 CM_L4 -32.768 32.767
    /end CHARACTERISTIC
    /begin CHARACTERISTIC AC_DCRU_PLAUS_L2_rate "32; verified (firmware s16=32). L2 plausibility rate term at flash 0x80043510 (raw, scale unconfirmed)."
      VALUE 0x80043510 RL_V_UWORD 0 CM_IDENTITY 0 65535
    /end CHARACTERISTIC
    /begin CHARACTERISTIC ACC_engine_torque_decel_limit_0_82 "-0.82 m/s2; verified (firmware s16=-164, signed). Engine-torque ACC decel FLOOR at flash 0x80079982 (BESCH_SOLLWERTBEGRENZUNG struct 0x80079940 +0x42), scale 0.005 m/s2. Engine caps its OWN ACC engine-braking authority here; harder decel is delegated to ESP brakes. Read by 801e6df0. More negative = harder engine-side decel. SECONDARY lever -- the primary -3.0 ESP-brake cap is the 0x5b71c curve."
      VALUE 0x80079982 RL_V_SWORD 0 CM_L5 -163.84 163.835
    /end CHARACTERISTIC
    /begin CHARACTERISTIC ACC_engine_torque_accel_limit_1_64 "+1.64 m/s2; verified (firmware s16=+328, signed). Engine-torque ACC accel CEILING at flash 0x80079980 (BESCH_SOLLWERTBEGRENZUNG struct 0x80079940 +0x40), scale 0.005 m/s2. Accel-side companion that bounds the engine-torque ACC setpoint to [-0.82,+1.64] together with the 0x80079982 floor. NOT a decel lever -- added for pair completeness."
      VALUE 0x80079980 RL_V_SWORD 0 CM_L5 -163.84 163.835
    /end CHARACTERISTIC
    /begin CHARACTERISTIC Cruise_torque_RISING_rate_limit_clutch_close_re_engage_smoothness "ACC/cruise engine-torque rising slope limiter (80141904); lower=smoother brake->drive torque pickup. NOT indexed by ACC_Dynamik (fixed). Cand C_TQ_GRD_NORM_CLU_CLOSE. RESULTS U62."
      VALUE 0x80043652 RL_V_UWORD 0 CM_L6 0 131070
    /end CHARACTERISTIC
    /begin CHARACTERISTIC Cruise_torque_FALLING_rate_limit_clutch_open_release "ACC/cruise engine-torque falling slope limiter (80141904). Cand C_TQ_GRD_CLU_OPEN. RESULTS U62."
      VALUE 0x80043650 RL_V_UWORD 0 CM_L6 0 131070
    /end CHARACTERISTIC
    /begin CHARACTERISTIC ACC_Dynamik_torque_scale_INERT_all_4_modes_500 "Value the ACC_Dynamik 4-way switch (8013e47c) selects; all 4 branches = this (0x43a96/aa2/aa4), so ACC_Dynamik has no effect. Edit to change the shared torque-rate scale. RESULTS U62."
      VALUE 0x80043a96 RL_V_UWORD 0 CM_IDENTITY 0 65535
    /end CHARACTERISTIC
