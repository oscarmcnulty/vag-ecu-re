# source this before running Ghidra scripts. Fresh container? JDK 21 is usually already
# present, and Ghidra installs from the GitHub *release-asset* URL even when general web
# egress is blocked — see CLAUDE.md "Ghidra setup" for the one-liner + sha256.
export JAVA_HOME="/usr/lib/jvm/java-21-openjdk-amd64"   # system JDK; or "$HOME/opt/jdk-21.x"
export GHIDRA_HOME="$HOME/opt/ghidra_12.1.2_PUBLIC"
export PATH="$JAVA_HOME/bin:$GHIDRA_HOME/support:$PATH"
